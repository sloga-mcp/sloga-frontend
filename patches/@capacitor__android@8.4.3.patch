+    // Sloga: whether the live bridge is the main-frame-only WebMessageListener. The fallback,
+    // addJavascriptInterface, takes calls from every frame of the page, so native code that must
+    // only serve the main frame (the protected-text commands) refuses unless this is true. It
+    // starts false and is set true in one place only: after addWebMessageListener has returned.
+    public static volatile boolean usingWebMessageListener = false;
 
     public MessageHandler(Bridge bridge, WebView webView, PluginManager cordovaPluginManager) {
         this.bridge = bridge;
         this.webView = webView;
         this.cordovaPluginManager = cordovaPluginManager;
+        usingWebMessageListener = false;
 

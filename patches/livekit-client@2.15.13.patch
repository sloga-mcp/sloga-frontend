+// this interval runs at module scope, before `init`. Gate (d) treats its
+// ABSENCE as amber; it must not read its presence as evidence of witnessing.
+setInterval(() => {
+  const participants = [];
+  slogaWitness.forEach((byIndex, identity) => {
+    const indexes = [];
+    byIndex.forEach((tally, keyIndex) => {
+      indexes.push({ keyIndex: keyIndex, seen: tally.seen, dropped: tally.dropped });
+    });
+    participants.push({ identity: identity, indexes: indexes });
+  });
+  slogaWitness.clear();
+  postMessage({ kind: 'slogaDecodeWitness', data: { participants: participants, rte: typeof self.RTCTransformEvent } });
+}, 1000);

+// --- Sloga: the decode witness (media-E2EE chip gate (d)) --------------------
+// Per SENDER, the key indexes frames actually ARRIVED at in the last window and
+// how many of those this worker threw away because it had already marked that
+// index invalid. Flushed to the main thread once a second.
+//
+// Why it lives HERE and not in `RTCRtpReceiver.getStats()`. The chip's green was
+// the DEFAULT: it went amber only while a verdict OBJECT happened to exist, so a
+// verdict destroyed without evidence -- or never created -- read as green over
+// frames this worker was silently dropping. Six review rounds each found that
+// posture in a different place. Inverting it needs a POSITIVE witness, and a
+// getStats one does not work: `framesDecoded` and
+// `totalSamplesReceived - concealedSamples` are counted AFTER the SIF
+// passthrough below, so SFU-injected blank/silence frames advance them for a
+// participant whose real frames are being dropped. This tally is read only once
+// that passthrough has already returned, so an injected frame never reaches it.
+//
+// It is also INDEX-scoped, which a getStats witness is not: it names the exact
+// key index a sender is using right now. A verdict about an index may only be
+// created by evidence about that index.
+const slogaWitness = new Map();
+function slogaNoteDecode(participantIdentity, keyIndex, dropped) {
+  if (participantIdentity === undefined) return;
+  let byIndex = slogaWitness.get(participantIdentity);
+  if (!byIndex) {
+    byIndex = new Map();
+    slogaWitness.set(participantIdentity, byIndex);
+  }
+  const tally = byIndex.get(keyIndex) || { seen: 0, dropped: 0 };
+  tally.seen += 1;
+  if (dropped) tally.dropped += 1;
+  byIndex.set(keyIndex, tally);
+}
+// Posted unconditionally every second, even with nothing to report: its ARRIVAL
+// is what tells the main thread the patch is present at all. A build that lost
+// the patch stops sending it, and the chip fails closed to amber and says so,
+// instead of quietly losing the gate.
+setInterval(() => {
+  const participants = [];
+  slogaWitness.forEach((byIndex, identity) => {
+    const indexes = [];
+    byIndex.forEach((tally, keyIndex) => {
+      indexes.push({ keyIndex: keyIndex, seen: tally.seen, dropped: tally.dropped });
+    });
+    participants.push({ identity: identity, indexes: indexes });
+  });
+  slogaWitness.clear();
+  postMessage({ kind: 'slogaDecodeWitness', data: { participants: participants } });
+}, 1000);

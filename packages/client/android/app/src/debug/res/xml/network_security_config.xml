<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config (screen-leg plan §17.5).

  Production talks to app.sloga.gg over https/wss, so cleartext stays
  forbidden everywhere by default — this file lives in the `debug` source set
  and is NEVER merged into a release APK.

  Why it exists: the screen leg's LiveKit socket is opened by the
  livekit-android SDK natively, so it is governed by the app's network
  security policy (NOT the WebView CSP). A local dev stack serves LiveKit
  over ws:// on the emulator host alias 10.0.2.2, which Android blocks
  outright on targetSdk 28+ — the plugin surfaces it as
  "CLEARTEXT communication to 10.0.2.2 not permitted by network security
  policy". Scoped to that one literal address so a debug build still refuses
  cleartext to anything else, including a real server.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host loopback. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
